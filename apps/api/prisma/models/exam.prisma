// Question

model Question {
  id                  String              @id @default(uuid())
  text                String
  
  creator             User                @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  creatorId           String

  correctOptionIndex  Int
  explanation         String

  difficulty          QuestionDifficulty

  groupId             String?
  version             Int                 @default(1)

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?

  options             QuestionOption[]
  examQuestions       ExamQuestion[]

  questionTags        QuestionTag[]

  userAnswers         UserAnswer[]
}

model QuestionOption {
  id                  String              @id @default(uuid())
  question            Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId          String
  optionIndex         Int
  text                String

  @@unique([questionId, optionIndex])
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

model Tag {
  id                  String              @id @default(uuid())
  name                String              @unique

  questions           QuestionTag[]
}

model QuestionTag {
  id                  String              @id @default(uuid())
  tag                 Tag                 @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId               String
  question            Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId          String

  @@unique([questionId, tagId])
}

// Exam

model Exam {
  id                  String              @id @default(uuid())
  title               String
  description         String?

  targetExam          TargetExam          @relation(fields: [targetExamId], references: [id], onDelete: Restrict)
  targetExamId        String

  groupId             String?
  version             Int                 @default(1)
  
  creator             User                @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  creatorId           String

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  publishedAt         DateTime?
  deletedAt           DateTime?

  examQuestions       ExamQuestion[]

  examAttempts        ExamAttempt[]
}

model ExamQuestion {
  id                  String              @id @default(uuid())
  exam                Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  examId              String
  question            Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId          String
  orderIndex          Int

  @@unique([examId, questionId])
  @@index([examId, orderIndex])
}

model TargetExam {
  id                  String              @id @default(uuid())
  name                String              @unique   // "UPCAT", "Civil Service Exam"
  slug                String              @unique   // "upcat", "cse"

  exams               Exam[]
}

// Exam Attempts

model ExamAttempt {
  id                  String              @id @default(uuid())

  user                User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId              String

  exam                Exam                @relation(fields: [examId], references: [id], onDelete: Restrict)
  examId              String
  examVersion         Int

  score               Float?
  startedAt           DateTime            @default(now())
  submittedAt         DateTime?

  answers             UserAnswer[]
}

model UserAnswer {
  id                  String              @id @default(uuid())

  attempt             ExamAttempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId           String

  question            Question            @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionId          String

  selectedIndex       Int?
  isCorrect           Boolean?

  answeredAt          DateTime            @default(now())

  @@unique([attemptId, questionId])
}